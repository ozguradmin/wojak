__pycache__/
*.pyc
.cache/
out/
referans/
*.env
.env*
cookies*.txt

# Lisanslı fontlar (Avenir LT Std): repo herkese açık, dağıtılamaz
assets/fonts/ozel/

# Kanalın imza orijinal sesi (hesabın kendi reel'lerinden çıkarılır; hak sahibi belirsiz, repo açık)
assets/music/ozel/

# Herkese açık repo: telifli haber görselleri ve kanal sesi gömülü videolar repoya girmez (sohbetten teslim edilir)
episodes/*/img/telifli/
uzun/*/img/telifli/
teslim/*/*.mp4

# Uzun format (wojak/uzun): videolar ve ses önbelleği out/ altında; teslim/<id>-uzun/*.mp4 yukarıdaki kuralla dışarıda
tools/telegram/node_modules/

# Gündem (güncel olay) bölümleri herkese açık depoya girmez (1.11): yayın yasağı sonradan gelebilir (Narin: 8 gün sonra,
# sosyal medya ve internet dahil) ve git geçmişinden silinemez. Bölüm klasörü özel depoda gundem/<id>/, paket teslim/<id>/.
episodes/gundem-*/
teslim/gundem-*/
arastirma/hava_muzik/cache/
arastirma/hava_muzik/.kulak.lock
